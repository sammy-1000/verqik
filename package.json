{
  "name": "verqik",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:server": "turbo dev --filter=server",
    "dev:web": "turbo dev --filter=web",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @verqik/database db:generate",
    "db:push": "pnpm --filter @verqik/database db:push",
    "db:migrate": "pnpm --filter @verqik/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @verqik/database db:migrate:deploy",
    "db:seed": "pnpm --filter @verqik/database db:seed",
    "db:city-images:download": "pnpm --filter @verqik/database db:city-images:download",
    "admin:create": "pnpm --filter server admin:create",
    "seed:demo": "pnpm --filter server seed:demo"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
