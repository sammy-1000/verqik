# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/verqik?schema=public"

# Application
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Demo seed CLI (pnpm seed:demo)
DEMO_SEED_PASSWORD=DemoVerqik2026!

# Bootstrap admin user (optional — created on server start if set)
# CLI: pnpm admin:create (interactive locally)
# Prod: pnpm admin:create --non-interactive --email=... --password=...
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin
ADMIN_RESET_PASSWORD=false

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# WebAuthn (future)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# S3-compatible storage (MinIO, AWS S3, etc.)
# STORAGE_ENDPOINT — used for uploads (presigned PUT) and server-side S3 API calls
# STORAGE_CDN_URL — public base for read URLs returned to clients (may include bucket path)
#   e.g. https://s3api.kiin.rw/verqik-dev  (bucket already in path)
#   or   https://cdn.example.com             (bucket appended automatically)
STORAGE_FORCE_PATH_STYLE=true
STORAGE_CDN_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=verqik
STORAGE_ENDPOINT=http://localhost:9000

# CORS
CORS_PERMISSIVE=true

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@verqik.com

# WebSocket (Socket.IO — primary client interface)
WS_PATH=/socket.io
WS_TRANSPORTS=websocket,polling

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
