{
  "name": "server",
  "version": "0.0.1",
  "description": "Verqik crowdshipping API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "predev": "pnpm --filter @verqik/database build && pnpm --filter @verqik/common build && pnpm --filter @verqik/email build && pnpm --filter @verqik/storage build",
    "dev": "pnpm db:migrate:deploy && NODE_ENV=development nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "pnpm --filter @verqik/database db:generate",
    "db:push": "pnpm --filter @verqik/database db:push",
    "db:migrate": "pnpm --filter @verqik/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @verqik/database db:migrate:deploy",
    "db:seed": "pnpm --filter @verqik/database db:seed",
    "admin:create": "node dist/cli/create-admin-cli.js",
    "admin:create:build": "nest build && node dist/cli/create-admin-cli.js",
    "seed:demo": "node dist/cli/seed-demo-cli.js",
    "seed:demo:build": "nest build && node dist/cli/seed-demo-cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.0.1",
    "@verqik/common": "workspace:*",
    "@verqik/database": "workspace:*",
    "@verqik/email": "workspace:*",
    "@verqik/storage": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "@inquirer/prompts": "^7.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
